NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dcq

# memory | redis-streams | rabbitmq
BROKER_TRANSPORT=redis-streams
RABBITMQ_URL=amqp://guest:guest@localhost:5672
BROKER_MAX_ATTEMPTS=3
BROKER_CONSUMER_NAME=instance-1

QUESTION_ASSET_CACHE_TTL=900
ENCOUNTER_TTL_SECONDS=120